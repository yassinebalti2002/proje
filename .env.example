# ══════════════════════════════════════════════════════════════════════════════
#  .env.example — Template de configuration pour la production
#  Copier ce fichier en .env et remplir toutes les valeurs.
#  NE JAMAIS commiter le fichier .env dans Git.
#
#  Générer une clé API sécurisée :
#    python -c "import secrets; print(secrets.token_hex(32))"
# ══════════════════════════════════════════════════════════════════════════════

# ── Authentification API (RBAC 2 niveaux) ──────────────────────────────────────
# API_KEYS         : clés ADMIN — accès complet, y compris déclenchement de
#                     ré-entraînement (/v1/pipeline/upload). A réserver à un
#                     nombre restreint de personnes (data scientist, ops).
# API_KEYS_OPERATOR : clés OPERATEUR (optionnel) — accès prédiction/consultation,
#                     PAS le ré-entraînement. A distribuer aux intégrations
#                     tierces (Node-RED, dashboard, collègues) sans leur donner
#                     le pouvoir de relancer un entraînement.
# Plusieurs clés séparées par des virgules dans chaque variable.
API_KEYS=changez-moi-generez-avec-secrets.token_hex
API_KEYS_OPERATOR=

# Emplacement du journal d'audit (JSON lines, une ligne par tentative d'auth)
AUDIT_LOG_PATH=logs/audit.log

# ── Authentification utilisateurs (JWT) ────────────────────────────────────────
# Système de comptes séparé (register/login humain, ex. app mobile) — n'a
# aucun rapport avec API_KEYS ci-dessus. Table users créée automatiquement
# au démarrage (voir user_auth.py) mais nécessite un compte MARIADB_USER avec
# des privilèges élargis, voir la note sous "Base de données MariaDB".
# Secret de signature des tokens (HS256) — DOIT être différent de API_KEYS.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changez-moi-generez-avec-secrets.token_hex
# Durée de validité d'un token, en minutes
JWT_EXPIRE_MINUTES=60

# ── Base de données MariaDB ────────────────────────────────────────────────────
# Utiliser un compte dédié avec privilèges SELECT uniquement (jamais root).
# EXCEPTION : la table "users" (comptes utilisateurs, voir JWT_SECRET ci-dessus)
# a besoin d'écrire — sans la commande ci-dessous, /v1/auth/register et
# /v1/auth/login répondent 503 même une fois le code déployé :
#   GRANT SELECT, INSERT, UPDATE, CREATE ON ai_cp.users TO 'app_user'@'%';
MARIADB_HOST=192.168.120.58
MARIADB_PORT=3306
MARIADB_USER=app_user
MARIADB_PASSWORD=changez-moi
MARIADB_DATABASE=ai_cp

# ── Passerelle IFM ────────────────────────────────────────────────────────────
IFM_GATEWAY_HOST=192.168.1.50
IFM_GATEWAY_PORT=80

# ── CORS (origines autorisées) ─────────────────────────────────────────────────
# En production : lister les domaines autorisés séparés par des virgules.
# Laisser vide pour autoriser toutes les origines (dev uniquement).
# Exemple prod : CORS_ORIGINS=https://dashboard.usine.tn,http://192.168.1.100:3000
CORS_ORIGINS=

# ── Alertes (optionnel) ────────────────────────────────────────────────────────
# Configurées dans alert_config.json — ne pas mettre les credentials ici.

# ── Mode démo ─────────────────────────────────────────────────────────────────
# true = retourne des données simulées sans base de données réelle
DEMO_MODE=false

# ── TLS / HTTPS (optionnel) ─────────────────────────────────────────────────────
# Laisser vide = API en HTTP simple (comportement historique, inchangé).
# Pour activer HTTPS :
#   1. Certificat de test (réseau interne usine, pas de nom de domaine) :
#        python generate_selfsigned_cert.py --cn <IP_ou_hostname_du_serveur>
#      -> avertissement navigateur "non sécurisé" tant que le certificat
#         n'est pas installé comme approuvé sur les postes clients.
#   2. Certificat de production (nom de domaine réel) :
#        certbot certonly ... (Let's Encrypt, gratuit) ou certificat de
#        l'autorité de certification interne de l'entreprise.
# TLS_CERT_FILE=certs/server.crt
# TLS_KEY_FILE=certs/server.key
